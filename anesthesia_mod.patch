+RegisterCase({
+    format: "modern",
+    id: "modern_adult_gyn_anaphylaxis_10m",
+    title: "Modern Case 2 - 42yo Female Diagnostic Hysteroscopy (Anaphylaxis)",
+    patientCategory: "adult",
+    possiblePoints: 1000,
+    pkTimeScale: 3.5,
+    gasTimeScale: 2.5,
+    preopMsg: "42 year old female (64 kg) scheduled for routine hysteroscopy and D&C.\n\nHISTORY: Menorrhagia, otherwise healthy. No prior anesthetic complications.\nMEDICATIONS: Oral iron.\nALLERGIES: NKDA.\nEXAM: HR 76, BP 118/72, SpO2 99% on RA, RR 14. Mallampati I, normal airway.\nLABS: Hct 36%, Na+ 140, K+ 4.0, Glucose 92.",
+    learningObj: "1. Perform routine IV induction and airway management.\n2. Recognize sudden distributive shock + bronchospasm + cutaneous flushing after antibiotic/surgical start.\n3. Treat promptly with Epinephrine, 100% O2, rapid IV crystalloid bolus, and adjuncts (Albuterol, Diphenhydramine/Hydrocortisone).",
+    debriefMsg: "Perioperative anaphylaxis can occur during any routine procedure. Immediate Epinephrine (titrated 10–100 mcg boluses or infusion), 100% O2, and aggressive IV fluid resuscitation are lifesaving.",
+    initialWhatNext: "Start IV fluids, preoxygenate, induce general anesthesia, secure the airway, and tell the surgeon to prep.",
+    initialRecordMsg: "42yo female in OR for routine hysteroscopy.",
+    patient: {
+        leanBodyMass: 64,
+        imageSet: 3,
+        durationPrep: 25,
+        durationSurgery: 600,
+        depthTubeInitial: 21,
+        depthCords: 18,
+        depthCarina: 25,
+        volAnDsp: 120,
+        coMin: 1.5,
+        baseHr: 76, spRate: 76,
+        baseAbpS: 118, baseAbpD: 72, baseAbpM: 87,
+        cvp: 7, papS: 22, papD: 9, papM: 14, papW: 7,
+        cardiacOutput: 5.1,
+        initialSat: 99, sat20: 96, sat40: 99, sat100: 100,
+        spontRr: 14, spontTv: 480, contPip: 22,
+        hct: 36, glucose: 92, basePot: 4.0, sodium: 140, baseBicarb: 24.0, temperature: 36.8,
+        rhythm: "Sinus1", airwayStr: "nl", laryTubeSuccess: 1, lmaSuccessFlag: true
+    },
+    events: [
+        {
+            id: "iv_ready",
+            when: [{ type: "tFluid", op: "GT", value: 0.1 }],
+            points: 100,
+            log: "IV infusion running.",
+            whatNext: "Preoxygenate, induce anesthesia, and secure the airway."
+        },
+        {
+            id: "airway_secured",
+            when: [{ type: "airwayTube", value: true }, { type: "tubeTrachea", value: true }, { type: "doa", op: "GT", value: 0.9 }],
+            points: 150,
+            log: "Airway secured under general anesthesia.",
+            whatNext: "Maintain anesthesia, ventilate, and instruct the surgeon to prep."
+        },
+        {
+            id: "anaphylaxis_onset",
+            when: [
+                { type: "doingSurgery", value: true },
+                { type: "timeSinceEvent", event: "incision", op: "GT", value: 60 }
+            ],
+            points: 0,
+            recordMsg: "Sudden hypotension, tachycardia, and high airway pressure.",
+            log: "ALERT: Acute hypotension, tachycardia, diffuse wheezing, and flushing after prophylactic antibiotic!",
+            whatNext: "Anaphylaxis! Give Epinephrine (10–100 mcg IV or infusion), 100% O2, rapid IV fluid bolus, and Albuterol.",
+            effects: {
+                baseHr: 136, spRate: 136,
+                baseAbpS: 64, baseAbpD: 34, baseAbpM: 44,
+                cvp: 3, cardiacOutput: 2.8,
+                airwayStr: "restricted", contPip: 46,
+                sat20: 80, sat40: 86, sat100: 92,
+                skinMsg: "Diffuse flushing and urticaria over chest and neck.",
+                breathSoundsMsg: "Diffuse bilateral expiratory wheezes."
+            }
+        },
+        {
+            id: "epi_given",
+            when: [
+                { type: "eventFired", event: "anaphylaxis_onset", value: true },
+                { type: "drugCe", drug: "Epinephrine", op: "GT", value: 0.35 }
+            ],
+            points: 350,
+            log: "Epinephrine administered — BP and bronchospasm improving.",
+            whatNext: "Give >500 mL IV fluid bolus and adjuncts (Albuterol, Diphenhydramine, or Hydrocortisone).",
+            effects: {
+                baseHr: 102, spRate: 102,
+                baseAbpS: 108, baseAbpD: 62, baseAbpM: 77,
+                cvp: 6, cardiacOutput: 4.6,
+                airwayStr: "restricted", contPip: 33,
+                sat20: 91, sat40: 96, sat100: 98,
+                breathSoundsMsg: "Mild residual end-expiratory wheezing."
+            }
+        },
+        {
+            id: "fluids_given",
+            when: [
+                { type: "eventFired", event: "anaphylaxis_onset", value: true },
+                { type: "tFluid", op: "GT", value: 500 }
+            ],
+            points: 200,
+            log: "Intravascular volume restored with IV fluids."
+        },
+        {
+            id: "adjunct_given",
+            when: [
+                { type: "eventFired", event: "anaphylaxis_onset", value: true },
+                { type: "bDrug", drug: "Albuterol", op: "GT", value: 3 }
+            ],
+            points: 100,
+            log: "Bronchodilator administered — airway resistance normalized.",
+            effects: {
+                airwayStr: "nl", contPip: 23,
+                sat20: 95, sat40: 98, sat100: 100,
+                breathSoundsMsg: "Breath sounds clear bilaterally."
+            }
+        },
+        {
+            id: "case_resolved",
+            when: [
+                { type: "eventFired", event: "epi_given", value: true },
+                { type: "eventFired", event: "fluids_given", value: true },
+                { type: "map", op: "GT", value: 65 }
+            ],
+            points: 100,
+            finalState: 1,
+            recordMsg: "Patient stabilized after intraoperative anaphylaxis.",
+            log: "Patient stable! Case objectives complete.",
+            whatNext: "Case complete! Monitor until procedure concludes or review Case Log."
+        }
+    ]
+});
