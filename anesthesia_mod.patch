+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Anesthesia Sim Quick-Lookup Tool</title>
+    <script src="https://cdn.tailwindcss.com"></script>
+    <script>
+        tailwind.config = {
+            darkMode: 'class',
+            theme: {
+                extend: {
+                    colors: {
+                        darker: '#0f172a',
+                        card: '#1e293b',
+                        accent: '#3b82f6'
+                    }
+                }
+            }
+        }
+    </script>
+</head>
+<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased selection:bg-blue-500 selection:text-white">
+
+    <!-- Top Bar / Global Controls -->
+    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur border-b border-slate-800 px-4 py-3 shadow-md">
+        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
+            <div class="flex items-center gap-3">
+                <div class="bg-blue-600 text-white p-2 rounded-lg font-bold text-lg tracking-wider shadow">🫀 AnesCalc</div>
+                <div>
+                    <h1 class="font-bold text-base sm:text-lg text-slate-100">Anesthesia Sim Quick Lookup</h1>
+                    <p class="text-xs text-slate-400">Instant dosage & pharmacodynamic reference</p>
+                </div>
+            </div>
+
+            <div class="flex items-center gap-4 w-full sm:w-auto justify-end">
+                <div class="flex items-center gap-2 bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700 shadow-inner">
+                    <label for="patientWeight" class="text-xs font-semibold uppercase text-slate-400 tracking-wider">Patient Weight:</label>
+                    <input type="number" id="patientWeight" value="70" min="1" max="300" 
+                        class="w-16 bg-slate-900 text-blue-400 font-bold text-center rounded border border-slate-700 px-1 py-0.5 focus:outline-none focus:border-blue-500">
+                    <span class="text-xs text-slate-400 font-medium">kg</span>
+                </div>
+            </div>
+        </div>
+    </header>
+
+    <!-- Main Container -->
+    <main class="max-w-7xl mx-auto px-4 py-6">
+        
+        <!-- Search & Filter Controls -->
+        <div class="mb-6 space-y-4">
+            <div class="relative">
+                <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
+                    🔍
+                </span>
+                <input type="text" id="searchInput" placeholder="Search by drug name, indication (e.g. 'bradycardia', 'bronchospasm'), or action... (Press '/' to focus)" 
+                    class="w-full pl-11 pr-4 py-3 bg-slate-900 border border-slate-800 rounded-xl text-slate-100 placeholder-slate-500 shadow-lg focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all text-sm sm:text-base">
+            </div>
+
+            <!-- Category Pills -->
+            <div id="categoryFilters" class="flex flex-wrap gap-2 text-xs font-medium">
+                <!-- Buttons are built by JavaScript from the editable groups -->
+            </div>
+        </div>
+
+        <!-- Drug Grid -->
+        <div id="drugGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
+            <!-- Populated via JavaScript -->
+        </div>
+
+        <!-- Empty State -->
+        <div id="emptyState" class="hidden text-center py-16">
+            <div class="text-4xl mb-2">🧪</div>
+            <h3 class="text-lg font-semibold text-slate-300">No matching drugs found</h3>
+            <p class="text-sm text-slate-500">Try adjusting your search query or filters.</p>
+        </div>
+    </main>
+
+    <!-- Detailed Modal -->
+    <div id="drugModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200">
+        <div class="bg-slate-900 border border-slate-800 w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-200" id="modalContent">
+            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/50">
+                <div>
+                    <span id="modalBadge" class="text-xs font-semibold px-2.5 py-1 rounded bg-blue-500/20 text-blue-400 border border-blue-500/30">Drug Profile</span>
+                    <h2 id="modalTitle" class="text-2xl font-bold text-slate-100 mt-1">Drug Name</h2>
+                </div>
+                <button id="closeModal" class="text-slate-400 hover:text-white p-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 transition">✕</button>
+            </div>
+            <div class="p-6 space-y-5 max-h-[75vh] overflow-y-auto">
+                <div>
+                    <h3 class="text-xs font-semibold text-blue-400 uppercase tracking-wider mb-1">Indications & Uses</h3>
+                    <p id="modalUse" class="text-slate-200 text-sm whitespace-pre-line bg-slate-950/40 p-3 rounded-xl border border-slate-800/80"></p>
+                </div>
+                <div>
+                    <h3 class="text-xs font-semibold text-blue-400 uppercase tracking-wider mb-1">Standard Dosage (Patient Calculated)</h3>
+                    <div id="modalDose" class="text-slate-200 text-sm whitespace-pre-line bg-blue-950/20 p-3 rounded-xl border border-blue-900/30 font-mono"></div>
+                </div>
+                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
+                    <div>
+                        <h3 class="text-xs font-semibold text-blue-400 uppercase tracking-wider mb-1">Mechanism of Action</h3>
+                        <p id="modalAction" class="text-slate-300 text-xs whitespace-pre-line bg-slate-950/40 p-3 rounded-xl border border-slate-800/80 h-full"></p>
+                    </div>
+                    <div>
+                        <h3 class="text-xs font-semibold text-amber-400 uppercase tracking-wider mb-1">Complications & Cautions</h3>
+                        <p id="modalComplication" class="text-slate-300 text-xs whitespace-pre-line bg-amber-950/10 p-3 rounded-xl border border-amber-900/20 h-full"></p>
+                    </div>
+                </div>
+            </div>
+            <div class="px-6 py-3 bg-slate-950 border-t border-slate-800 flex justify-end">
+                <button id="closeModalBtn" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-medium rounded-xl transition">Close</button>
+            </div>
+        </div>
+    </div>
+
+    <!-- Group Editor Modal -->
+    <div id="groupModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden">
+        <div class="bg-slate-900 border border-slate-800 w-full max-w-xl rounded-2xl shadow-2xl overflow-hidden">
+            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/50">
+                <h2 class="text-xl font-bold text-slate-100">Edit Groups</h2>
+                <button id="closeGroupModal" class="text-slate-400 hover:text-white p-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 transition">✕</button>
+            </div>
+            <div class="p-6 space-y-3">
+                <div class="flex flex-wrap gap-2 items-center">
+                    <select id="groupSelect" class="flex-1 min-w-[10rem] bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-sm text-slate-100"></select>
+                    <button id="grpNew" class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-medium">+ New</button>
+                    <button id="grpRename" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-200 border border-slate-700 text-xs font-medium">Rename</button>
+                    <button id="grpDelete" class="px-3 py-1.5 rounded-lg bg-slate-800 text-red-400 border border-slate-700 text-xs font-medium">Delete</button>
+                </div>
+                <input type="text" id="groupDrugSearch" placeholder="Filter drug list..." class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-blue-500">
+                <div id="groupDrugList" class="max-h-[45vh] overflow-y-auto grid grid-cols-1 sm:grid-cols-2 gap-1 bg-slate-950/40 p-2 rounded-xl border border-slate-800/80 text-sm"></div>
+                <p id="groupCount" class="text-xs text-slate-500"></p>
+            </div>
+            <div class="px-6 py-3 bg-slate-950 border-t border-slate-800 flex justify-between">
+                <button id="grpReset" class="px-3 py-2 text-xs text-slate-400 hover:text-red-400">Reset to defaults</button>
+                <button id="closeGroupBtn" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-medium rounded-xl transition">Done</button>
+            </div>
+        </div>
+    </div>
+
