@@ -0,0 +1,103 @@
+RegisterCase({
+    format: "modern",
+    id: "modern_lap_chole_anaphylaxis",
+    title: "Original Case 1 - 38yo Laparoscopic Cholecystectomy (Intraop Crisis)",
+    possiblePoints: 1000,
+    pkTimeScale: 3.5,
+    gasTimeScale: 2.5,
+    preopMsg: "38 year old female for elective laparoscopic cholecystectomy (65 kg).\n\nPMH: Mild seasonal allergies, otherwise healthy.\nMedications: None.\nAllergies: NKDA.\nExam: HR 78, BP 122/74, SpO2 98% on RA. Airway Mallampati I, full neck ROM.\nLabs: Hct 40%, K+ 4.1, Glucose 96.",
+    learningObj: "1. Perform safe induction and airway management.\n2. Recognize sudden distributive shock + bronchospasm (anaphylaxis) after surgical start.\n3. Treat immediately with 100% O2, Epinephrine, IV fluids, and bronchodilation.",
+    debriefMsg: "Intraoperative anaphylaxis presents with sudden hypotension, tachycardia, high peak airway pressures, and a shark-fin capnogram. First-line treatment is Epinephrine, 100% O2, stopping triggers, and aggressive IV fluid resuscitation.",
+    initialWhatNext: "Start IV fluids, preoxygenate, induce anesthesia, secure the ETT, and instruct the surgeon to prep.",
+    patient: {
+        leanBodyMass: 65, imageSet: 5,
+        durationPrep: 25, durationSurgery: 900,
+        depthTubeInitial: 21, depthCords: 18, depthCarina: 25,
+        volAnDsp: 90, coMin: 1.2,
+        baseHr: 78, spRate: 78, baseAbpS: 122, baseAbpD: 74, baseAbpM: 90,
+        cvp: 8, papS: 24, papD: 10, papM: 15, papW: 8, cardiacOutput: 5.4,
+        initialSat: 98, sat20: 96, sat40: 99, sat100: 100,
+        spontRr: 14, spontTv: 520, contPip: 24,
+        hct: 40, glucose: 96, basePot: 4.1, sodium: 140, baseBicarb: 24.0, temperature: 36.8,
+        rhythm: "Sinus1", airwayStr: "nl", laryTubeSuccess: 1, lmaSuccessFlag: true
+    },
+    events: [
+        {
+            id: "iv_started",
+            when: [{ type: "tFluid", op: "GT", value: 0.1 }],
+            points: 100,
+            log: "IV access established.",
+            whatNext: "Preoxygenate (FiO2 > 80%), induce anesthesia, and intubate."
+        },
+        {
+            id: "ett_secured",
+            when: [{ type: "airwayTube", value: true }, { type: "tubeTrachea", value: true }, { type: "doa", op: "GT", value: 1.0 }],
+            points: 150,
+            log: "Endotracheal tube secured in trachea under general anesthesia.",
+            whatNext: "Start volatile maintenance (1-1.5 MAC), switch to ventilator, and tell surgeon to prep/incise."
+        },
+        {
+            id: "light_incision_penalty",
+            when: [{ type: "doingSurgery", value: true }, { type: "doa", op: "LT", value: 1.2 }],
+            points: -200,
+            log: "Incision made under inadequate anesthetic depth! Sympathetic surge.",
+            effects: { baseHr: 118, baseAbpS: 175, baseAbpD: 102, baseAbpM: 126 }
+        },
+        {
+            id: "crisis_anaphylaxis",
+            when: [
+                { type: "doingSurgery", value: true },
+                { type: "timeSinceEvent", event: "incision", op: "GT", value: 25 }
+            ],
+            points: 0,
+            recordMsg: "Acute hypotension and severe bronchospasm.",
+            log: "ALERT: Sudden hypotension, tachycardia, flushing, and rising airway pressures!",
+            whatNext: "Treat anaphylaxis immediately: Epinephrine (10-100 mcg boluses or infusion), 100% O2, IV fluid bolus, and Albuterol.",
+            effects: {
+                baseHr: 134, spRate: 134, baseAbpS: 66, baseAbpD: 36, baseAbpM: 46,
+                cvp: 3, cardiacOutput: 3.1, airwayStr: "restricted", contPip: 46,
+                sat20: 78, sat40: 85, sat100: 91,
+                skinMsg: "Diffuse erythema and urticaria across chest and neck.",
+                breathSoundsMsg: "Diffuse bilateral expiratory wheezes."
+            }
+        },
+        {
+            id: "epi_treated",
+            when: [
+                { type: "eventFired", event: "crisis_anaphylaxis", value: true },
+                { type: "drugCe", drug: "Epinephrine", op: "GT", value: 0.4 }
+            ],
+            points: 400,
+            log: "Epinephrine administered — hemodynamics and bronchospasm improving.",
+            whatNext: "Continue IV fluid resuscitation and verify airway pressures normalize.",
+            effects: {
+                baseHr: 104, spRate: 104, baseAbpS: 112, baseAbpD: 64, baseAbpM: 80,
+                cvp: 6, cardiacOutput: 4.9, airwayStr: "nl", contPip: 28,
+                sat20: 94, sat40: 98, sat100: 99,
+                breathSoundsMsg: "Wheezing has largely resolved."
+            }
+        },
+        {
+            id: "fluids_resuscitated",
+            when: [
+                { type: "eventFired", event: "crisis_anaphylaxis", value: true },
+                { type: "tFluid", op: "GT", value: 500 }
+            ],
+            points: 200,
+            log: "Adequate intravascular volume restored."
+        },
+        {
+            id: "crisis_resolved",
+            when: [
+                { type: "eventFired", event: "epi_treated", value: true },
+                { type: "eventFired", event: "fluids_resuscitated", value: true },
+                { type: "map", op: "GT", value: 65 }
+            ],
+            points: 150,
+            finalState: 1,
+            recordMsg: "Patient stabilized after intraoperative anaphylaxis.",
+            log: "Crisis resolved cleanly! Case objectives met.",
+            whatNext: "Case complete! Review the Case Log and debriefing."
+        }
+    ]
+});
