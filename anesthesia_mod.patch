+RegisterCase({
+    format: "modern",
+    id: "modern_peds_8yo_bronchospasm",
+    title: "Modern Case 3 - 8yo Child Tonsillectomy (Bronchospasm)",
+    patientCategory: "pediatric",
+    possiblePoints: 1000,
+    pkTimeScale: 3.5,
+    gasTimeScale: 2.5,
+    preopMsg: "8 year old child (26 kg) for elective tonsillectomy and adenoidectomy.\n\nHISTORY: Recurrent tonsillitis, mild intermittent asthma, recent mild URI 10 days ago (now afebrile).\nMEDICATIONS: Albuterol inhaler PRN.\nALLERGIES: NKDA.\nEXAM: HR 94, BP 102/62, SpO2 98% on RA, RR 20. Mallampati I.\nLABS: Hct 38%, Na+ 139, K+ 4.0, Glucose 90.",
+    learningObj: "1. Manage pediatric anesthesia with age-appropriate vitals, tidal volume (~6–8 mL/kg = 160–200 mL), and ETT depth (16 cm).\n2. Recognize severe intraoperative bronchospasm (high PIP, upsloping shark-fin capnogram, wheezing, desaturation).\n3. Treat with 100% O2, deepen volatile/IV anesthesia, and administer Albuterol.",
+    debriefMsg: "Children with reactive airways or recent URI are at high risk for perioperative bronchospasm during airway instrumentation or surgical stimulation. First-line treatment is 100% O2, deepening anesthesia (Sevoflurane/Propofol), and inhaled Albuterol.",
+    initialWhatNext: "Preoxygenate, induce anesthesia, intubate (ETT ~16 cm), and set pediatric ventilator (~180 mL TV, RR 18–20).",
+    initialRecordMsg: "8yo child (26 kg) in OR for T&A.",
+    patient: {
+        leanBodyMass: 26,
+        imageSet: 1,
+        durationPrep: 20,
+        durationSurgery: 600,
+        depthTubeInitial: 16,
+        depthCords: 13,
+        depthCarina: 19,
+        volAnDsp: 55,
+        coMin: 0.9,
+        baseHr: 94, spRate: 94,
+        baseAbpS: 102, baseAbpD: 62, baseAbpM: 75,
+        cvp: 6, papS: 20, papD: 8, papM: 12, papW: 6,
+        cardiacOutput: 3.2,
+        initialSat: 98, sat20: 95, sat40: 98, sat100: 100,
+        spontRr: 20, spontTv: 185, contPip: 18,
+        hct: 38, glucose: 90, basePot: 4.0, sodium: 139, baseBicarb: 23.5, temperature: 36.8,
+        rhythm: "Sinus1", airwayStr: "nl", laryTubeSuccess: 1, lmaSuccessFlag: true
+    },
+    events: [
+        {
+            id: "peds_intubated",
+            when: [{ type: "airwayTube", value: true }, { type: "tubeTrachea", value: true }, { type: "doa", op: "GT", value: 0.9 }],
+            points: 150,
+            log: "Endotracheal tube secured in trachea.",
+            whatNext: "Switch to ventilator (~180 mL TV, RR 18) and tell surgeon to prep."
+        },
+        {
+            id: "bronchospasm_onset",
+            when: [
+                { type: "doingSurgery", value: true },
+                { type: "timeSinceEvent", event: "incision", op: "GT", value: 20 }
+            ],
+            points: 0,
+            recordMsg: "Severe bronchospasm: high PIP, shark-fin capnogram, falling SpO2.",
+            log: "ALERT: Peak airway pressures jumping! Upsloping EtCO2 and bilateral wheezing!",
+            whatNext: "Treat bronchospasm: switch to 100% O2, deepen anesthesia (Sevoflurane/Propofol), and give Albuterol.",
+            effects: {
+                baseHr: 124, spRate: 124,
+                baseAbpS: 118, baseAbpD: 72, baseAbpM: 87,
+                airwayStr: "restricted", contPip: 42,
+                sat20: 76, sat40: 84, sat100: 91,
+                breathSoundsMsg: "Tight bilateral inspiratory and expiratory wheezes with prolonged expiration."
+            }
+        },
+        {
+            id: "deepened_anesthesia",
+            when: [
+                { type: "eventFired", event: "bronchospasm_onset", value: true },
+                { type: "doa", op: "GT", value: 1.5 }
+            ],
+            points: 250,
+            log: "Anesthetic depth increased — airway reactivity decreasing."
+        },
+        {
+            id: "albuterol_given",
+            when: [
+                { type: "eventFired", event: "bronchospasm_onset", value: true },
+                { type: "bDrug", drug: "Albuterol", op: "GT", value: 3 }
+            ],
+            points: 400,
+            log: "Albuterol administered — wheezing and airway pressures resolving!",
+            effects: {
+                baseHr: 102, spRate: 102,
+                baseAbpS: 104, baseAbpD: 62, baseAbpM: 76,
+                airwayStr: "nl", contPip: 20,
+                sat20: 94, sat40: 98, sat100: 100,
+                breathSoundsMsg: "Breath sounds clear bilaterally."
+            }
+        },
+        {
+            id: "bronchospasm_resolved",
+            when: [
+                { type: "eventFired", event: "albuterol_given", value: true },
+                { type: "o2Sat", op: "GT", value: 94 }
+            ],
+            points: 200,
+            finalState: 1,
+            recordMsg: "Bronchospasm resolved; oxygenation and airway pressures normalized.",
+            log: "Bronchospasm resolved cleanly! Case objectives complete.",
+            whatNext: "Case complete! Review the Case Log and debriefing."
+        }
+    ]
+});
