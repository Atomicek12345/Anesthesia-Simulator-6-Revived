+                if (odLine !== "—") doseHtml += `\n<span class="text-amber-300 text-xs">• Overdose Flag Threshold: ${odLine}</span>`;
+            }
+            modalDose.innerHTML = doseHtml;
+
+            modalAction.textContent = drug.actionStr || 'None specified';
+            modalComplication.textContent = drug.complicationStr || 'None listed';
+
+            modal.classList.remove('hidden');
