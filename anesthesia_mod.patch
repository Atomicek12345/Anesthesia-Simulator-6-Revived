--- /dev/null
+++ b/scripts/Alarms.js
@@ -0,0 +1,417 @@
+"use strict";
+
+var AlarmPausedUntilSec = 0;
+var AlarmApneaSec = 0;
+var AlarmLastPlayTime = 0;
+var AlarmLastPrio = "";
+var ActiveAlarms = [];
+var AlarmCachedBpSys = NaN;
+var AlarmCachedBpMean = NaN;
+var AlarmNoPerfusionSec = 0;
+
+function ReadMonitorNum(id) {
+    var el = $(id);
+    if (!el || el.offsetParent === null) return NaN;
+    var v = parseFloat(el.textContent);
+    return isFinite(v) ? v : NaN;
+}
+
+// IEC 60601-1-8 Frequencies (Hz)
+var IEC_NOTES = {
+    C4: 261.63, D4: 293.67, E4: 329.63, F4: 349.23,
+    Fs4: 369.99, G4: 392.00, A4: 440.00, B4: 493.88, C5: 523.25
+};
+
+var IEC_MELODIES = {
+    general:     { med: ["C4", "C4", "C4"], high: ["C4", "C4", "C4", "C4", "C4"] },
+    oxygen:      { med: ["C5", "B4", "A4"], high: ["C5", "B4", "A4", "G4", "F4"] },
+    cardiac:     { med: ["C4", "E4", "G4"], high: ["C4", "E4", "G4", "G4", "C5"] },
+    ventilation: { med: ["C4", "A4", "F4"], high: ["C4", "A4", "F4", "A4", "F4"] },
+    temperature: { med: ["C4", "D4", "E4"], high: ["C4", "D4", "E4", "F4", "G4"] },
+    perfusion:   { med: ["C4", "Fs4", "C4"], high: ["C4", "Fs4", "C4", "C4", "Fs4"] }
+};
+
+function ResetAlarms() {
+    AlarmLastPrio = "";
+    AlarmNoPerfusionSec = 0;
+    AlarmPausedUntilSec = 0;
+    AlarmApneaSec = 0;
+    AlarmLastPlayTime = 0;
+    AlarmCachedBpSys = NaN;
+    AlarmCachedBpMean = NaN;
+    ActiveAlarms = [];
+    ClearAlarmClasses();
+    UpdateAlarmHeaderUi();
+}
+
+function ToggleAlarmPause() {
+    if (typeof EnsureAudioCtx === "function") { EnsureAudioCtx(); }
+    if (!UserCaseRunning) return;
+    if (AlarmPausedUntilSec > CaseTimeInSec) {
+        AlarmPausedUntilSec = 0;
+    } else {
+        AlarmPausedUntilSec = CaseTimeInSec + 120; // 2-minute Dräger Audio Pause
+    }
+    UpdateAlarmHeaderUi();
+}
+
+function PlayIecNote(freq, startTime, durationSec, gainLevel) {
+    if (!SynthAudioCtx || SynthAudioCtx.state !== "running") return;
+    var harmonics = [
+        { mult: 1, amp: 0.45 },
+        { mult: 2, amp: 0.72 },
+        { mult: 3, amp: 0.40 },
+        { mult: 4, amp: 0.22 }
+    ];
+    var master = SynthAudioCtx.createGain();
+    var filter = SynthAudioCtx.createBiquadFilter();
+    filter.type = "lowpass";
+    filter.frequency.setValueAtTime(3200, startTime);
+
+    master.gain.setValueAtTime(0.0001, startTime);
+    master.gain.linearRampToValueAtTime(gainLevel, startTime + 0.008);
+    master.gain.setValueAtTime(gainLevel, startTime + durationSec - 0.014);
+    master.gain.exponentialRampToValueAtTime(0.0001, startTime + durationSec);
+
+    filter.connect(master);
+    master.connect(SynthAudioCtx.destination);
+
+    for (var i = 0; i < harmonics.length; i++) {
+        var osc = SynthAudioCtx.createOscillator();
+        var hg = SynthAudioCtx.createGain();
+        osc.type = "sine";
+        osc.frequency.setValueAtTime(freq * harmonics[i].mult, startTime);
+        hg.gain.setValueAtTime(harmonics[i].amp, startTime);
+        osc.connect(hg);
+        hg.connect(filter);
+        osc.start(startTime);
+        osc.stop(startTime + durationSec + 0.01);
+    }
+}
+
+function PlayIecAlarmBurst(category, priority) {
+    if (typeof EnsureAudioCtx === "function") { EnsureAudioCtx(); }
+    if (!SynthAudioCtx || SynthAudioCtx.state !== "running") return;
+    var mel = IEC_MELODIES[category] || IEC_MELODIES.general;
+    var now = SynthAudioCtx.currentTime + 0.02;
+
+    if (priority === "high") {
+        var offsets = [0.00, 0.24, 0.48, 0.90, 1.14];
+        for (var rep = 0; rep < 2; rep++) {
+            var base = now + rep * 1.85;
+            for (var i = 0; i < 5; i++) {
+                var f = IEC_NOTES[mel.high[i]];
+                PlayIecNote(f, base + offsets[i], 0.155, 0.38);
+            }
+        }
+    } else if (priority === "medium") {
+        var medOffsets = [0.00, 0.34, 0.68];
+        for (var j = 0; j < 3; j++) {
+            var fm = IEC_NOTES[mel.med[j]];
+            PlayIecNote(fm, now + medOffsets[j], 0.19, 0.30);
+        }
+    }
+}
+
+function GetAlarmLimits() {
+    var lbm = (CurrentCase && CurrentCase.leanBodyMass) ? CurrentCase.leanBodyMass : 70;
+    var cat = (CurrentCase && CurrentCase.patientCategory) ? CurrentCase.patientCategory : "";
+    if (!cat) {
+        if (lbm < 12) cat = "neonatal";
+        else if (lbm < 40) cat = "pediatric";
+        else cat = "adult";
+    }
+
+    var defaults;
+    if (cat === "neonatal") {
+        defaults = {
+            hrLowHigh: 75,  hrLowMed: 90,  hrHighMed: 175, hrHighHigh: 195,
+            sbpLowHigh: 48, sbpLowMed: 58, sbpHighMed: 100, sbpHighHigh: 115,
+            mapLowHigh: 35, mapLowMed: 42, mapHighHigh: 85,
+            pawHighMed: 28, pawHighHigh: 35,
+            spo2LowHigh: 85, spo2LowMed: 90,
+            etco2LowHigh: 18, etco2LowMed: 25, etco2HighMed: 48, etco2HighHigh: 55
+        };
+    } else if (cat === "pediatric") {
+        defaults = {
+            hrLowHigh: 55,  hrLowMed: 65,  hrHighMed: 135, hrHighHigh: 155,
+            sbpLowHigh: 68, sbpLowMed: 78, sbpHighMed: 130, sbpHighHigh: 145,
+            mapLowHigh: 45, mapLowMed: 52, mapHighHigh: 105,
+            pawHighMed: 30, pawHighHigh: 38,
+            spo2LowHigh: 88, spo2LowMed: 92,
+            etco2LowHigh: 18, etco2LowMed: 25, etco2HighMed: 48, etco2HighHigh: 55
+        };
+    } else {
+        defaults = {
+            hrLowHigh: 45,  hrLowMed: 52,  hrHighMed: 115, hrHighHigh: 140,
+            sbpLowHigh: 75, sbpLowMed: 88, sbpHighMed: 165, sbpHighHigh: 190,
+            mapLowHigh: 55, mapLowMed: 62, mapHighHigh: 130,
+            pawHighMed: 34, pawHighHigh: 40,
+            spo2LowHigh: 88, spo2LowMed: 92,
+            etco2LowHigh: 18, etco2LowMed: 25, etco2HighMed: 48, etco2HighHigh: 55
+        };
+    }
+
+    // Allow any modern case to override individual limits via CurrentCase.alarmLimits
+    if (CurrentCase && CurrentCase.alarmLimits) {
+        for (var k in CurrentCase.alarmLimits) {
+            if (Object.prototype.hasOwnProperty.call(CurrentCase.alarmLimits, k)) {
+                defaults[k] = CurrentCase.alarmLimits[k];
+            }
+        }
+    }
+    return defaults;
+}
+
+function EvaluateAlarms(uiOnly) {
+    var list = [];
+    var mon = $("divMonitor");
+    if (!UserCaseRunning || !CurrentState || (mon && mon.classList.contains("sim-paused"))) {
+        return list;
+    }
+
+    var rhythm = CurrentState.rhythm || "Sinus1";
+    var dispHr = ReadMonitorNum("txtHr");
+    var isArrest = (rhythm === "Asystole1" || rhythm === "Vfib2" || dispHr === 0 || PddHr < 11);
+    var lim = GetAlarmLimits();
+
+    // 1. GENERAL
+    if (UserOverdosedFlag) {
+        list.push({ cat: "general", prio: "high", box: "fieldsetEcg", msg: "*** DRUG OVERDOSE ***" });
+    } else if (!UserConnectedFlag && CaseTimeInSec > 45 && PddDoa > 0.8) {
+        list.push({ cat: "general", prio: "medium", box: "fieldsetAgm", msg: "CIRCUIT DISCONNECTED" });
+    }
+
+    // 2. CARDIAC
+    if (rhythm === "Asystole1" || dispHr === 0) {
+        list.push({ cat: "cardiac", prio: "high", box: "fieldsetEcg", msg: "*** ASYSTOLE ***" });
+    } else if (rhythm === "Vfib2") {
+        list.push({ cat: "cardiac", prio: "high", box: "fieldsetEcg", msg: "*** VENT FIB ***" });
+    } else if (rhythm === "Vtach3") {
+        list.push({ cat: "cardiac", prio: "high", box: "fieldsetEcg", msg: "*** VENT TACH ***" });
+    // HR check
+    } else if (!isNaN(dispHr)) {
+        if (dispHr > lim.hrHighHigh) {
+            list.push({ cat: "cardiac", prio: "high", box: "fieldsetEcg", msg: "*** HR HIGH " + dispHr.toFixed(0) + " ***" });
+        } else if (dispHr < lim.hrLowHigh) {
+            list.push({ cat: "cardiac", prio: "high", box: "fieldsetEcg", msg: "*** HR LOW " + dispHr.toFixed(0) + " ***" });
+        } else if (dispHr > lim.hrHighMed) {
+            list.push({ cat: "cardiac", prio: "medium", box: "fieldsetEcg", msg: "HR HIGH " + dispHr.toFixed(0) });
+        } else if (dispHr < lim.hrLowMed) {
+            list.push({ cat: "cardiac", prio: "medium", box: "fieldsetEcg", msg: "HR LOW " + dispHr.toFixed(0) });
+        } else if (rhythm === "Afib6") {
+            list.push({ cat: "cardiac", prio: "medium", box: "fieldsetEcg", msg: "ATRIAL FIB" });
+        } else if (rhythm === "Bigeminy" || rhythm === "Sinus3" || rhythm === "PVC") {
+            list.push({ cat: "cardiac", prio: "medium", box: "fieldsetEcg", msg: "PVC / ECTOPY" });
+        }
+    }
+    var stMax = Math.max(Math.abs(CurrentState.stSegII || 0), Math.abs(CurrentState.stSegV5 || 0));
+    if (stMax >= 1.5 && !isArrest && !isNaN(dispHr)) {
+        list.push({ cat: "cardiac", prio: "medium", box: "fieldsetEcg", msg: "ST DEVIATION" });
+    }
+
+    if (UserMonitorDisplayStr === "abp" || (UserMonitorDisplayStr === "nbp" && UserNbpModeStr !== "inflating")) {
+        var sdEl = $("txtS-D");
+        var mVal = ReadMonitorNum("txtM");
+        if (sdEl && sdEl.offsetParent !== null && sdEl.textContent.indexOf("/") > 0 && !isNaN(mVal) && mVal > 0) {
+            var sVal = parseFloat(sdEl.textContent.split("/")[0]);
+            if (isFinite(sVal) && sVal >= 15) {
+                AlarmCachedBpSys = sVal;
+                AlarmCachedBpMean = mVal;
+            }
+        }
+    }
+    // BP check
+    if (!isArrest && !isNaN(AlarmCachedBpSys) && !isNaN(AlarmCachedBpMean)) {
+        if (AlarmCachedBpSys < lim.sbpLowHigh || AlarmCachedBpMean < lim.mapLowHigh) {
+            list.push({ cat: "cardiac", prio: "high", box: "fieldsetP1", msg: "*** BP LOW " + AlarmCachedBpSys.toFixed(0) + " ***" });
+        } else if (AlarmCachedBpSys > lim.sbpHighHigh || AlarmCachedBpMean > lim.mapHighHigh) {
+            list.push({ cat: "cardiac", prio: "high", box: "fieldsetP1", msg: "*** BP HIGH " + AlarmCachedBpSys.toFixed(0) + " ***" });
+        } else if (AlarmCachedBpSys < lim.sbpLowMed || AlarmCachedBpMean < lim.mapLowMed) {
+            list.push({ cat: "cardiac", prio: "medium", box: "fieldsetP1", msg: "BP LOW " + AlarmCachedBpSys.toFixed(0) });
+        } else if (AlarmCachedBpSys > lim.sbpHighMed) {
+            list.push({ cat: "cardiac", prio: "medium", box: "fieldsetP1", msg: "BP HIGH " + AlarmCachedBpSys.toFixed(0) });
+        }
+    }
+
+    // 3. OXYGEN & NO-PERFUSION SpO2 BLANKING (--- after 7s)
+    var noPerfusion = (isArrest && !UserDoingCprFlag) || (!UserDoingCprFlag && CurrentState.spSignal === 0);
+    if (!uiOnly) {
+        if (noPerfusion) {
+            AlarmNoPerfusionSec++;
+        } else {
+            AlarmNoPerfusionSec = 0;
+        }
+    }
+
+    if (noPerfusion && AlarmNoPerfusionSec >= 7) {
+        if ($("txtSpo2Sat"))    { $("txtSpo2Sat").innerHTML = "---"; }
+        if ($("txtSpo2Hr"))     { $("txtSpo2Hr").innerHTML = "Rate ---"; }
+        if ($("txtSpo2signal")) { $("txtSpo2signal").innerHTML = ""; }
+    } else if (UserDoingCprFlag && isArrest) {
+        // CPR restores pulsatile plethysmography at compression rate (~100/min)
+        if ($("txtSpo2Sat") && typeof PrpSpO2 === "number") { $("txtSpo2Sat").innerHTML = PrpSpO2.toFixed(0); }
+        if ($("txtSpo2Hr"))     { $("txtSpo2Hr").innerHTML = "Rate 100"; }
+        if ($("txtSpo2signal")) { $("txtSpo2signal").innerHTML = "*"; }
+    }
+
+    var dispSpo2 = ReadMonitorNum("txtSpo2Sat");
+    // SpO2 check
+    if (!isNaN(dispSpo2)) {
+        if (dispSpo2 < lim.spo2LowHigh) {
+            list.push({ cat: "oxygen", prio: "high", box: "fieldsetSpo2", msg: "*** SpO2 LOW " + dispSpo2.toFixed(0) + "% ***" });
+        } else if (dispSpo2 < lim.spo2LowMed) {
+            list.push({ cat: "oxygen", prio: "medium", box: "fieldsetSpo2", msg: "SpO2 LOW " + dispSpo2.toFixed(0) + "%" });
+        }
+    }
+
+    var dispFiO2 = ReadMonitorNum("txtI-O2");
+    if (UserConnectedFlag && !isNaN(dispPip)) {
+        if (dispPip > lim.pawHighHigh) {
+            list.push({ cat: "ventilation", prio: "high", box: "fieldsetAwp", msg: "*** PAW HIGH " + dispPip.toFixed(0) + " ***" });
+        } else if (dispPip > lim.pawHighMed) {
+            list.push({ cat: "ventilation", prio: "medium", box: "fieldsetAwp", msg: "PAW HIGH " + dispPip.toFixed(0) });
+        }
+    }
+
+    // 4. VENTILATION
+    if (!uiOnly) {
+        if (UserConnectedFlag && (PrpMonRr === 0 || PrpEtCO2 < 5)) {
+            AlarmApneaSec++;
+        } else {
+            AlarmApneaSec = 0;
+        }
+    }
+    if (UserConnectedFlag && AlarmApneaSec >= 12) {
+        list.push({ cat: "ventilation", prio: "high", box: "fieldsetAgm", msg: "*** APNEA ***" });
+    }
+
+    var dispPip = ReadMonitorNum("txtPip");
+    if (UserConnectedFlag && !isNaN(dispPip)) {
+        if (dispPip > 40) {
+            list.push({ cat: "ventilation", prio: "high", box: "fieldsetAwp", msg: "*** PAW HIGH " + dispPip.toFixed(0) + " ***" });
+        } else if (dispPip > 34) {
+            list.push({ cat: "ventilation", prio: "medium", box: "fieldsetAwp", msg: "PAW HIGH " + dispPip.toFixed(0) });
+        }
+    }
+
+    var dispEtCO2 = ReadMonitorNum("txtEtCO2");
+    if (UserConnectedFlag && !isNaN(dispEtCO2)) {
+        if (dispEtCO2 > lim.etco2HighHigh) {
+            list.push({ cat: "ventilation", prio: "high", box: "fieldsetAgm", msg: "*** EtCO2 HIGH " + dispEtCO2.toFixed(0) + " ***" });
+        } else if (dispEtCO2 > 4 && dispEtCO2 < lim.etco2LowHigh) {
+            list.push({ cat: "ventilation", prio: "high", box: "fieldsetAgm", msg: "*** EtCO2 LOW " + dispEtCO2.toFixed(0) + " ***" });
+        } else if (dispEtCO2 > lim.etco2HighMed) {
+            list.push({ cat: "ventilation", prio: "medium", box: "fieldsetAgm", msg: "EtCO2 HIGH " + dispEtCO2.toFixed(0) });
+        } else if (dispEtCO2 >= lim.etco2LowHigh && dispEtCO2 < lim.etco2LowMed) {
+            list.push({ cat: "ventilation", prio: "medium", box: "fieldsetAgm", msg: "EtCO2 LOW " + dispEtCO2.toFixed(0) });
+        }
+    }
+
+    // 5. TEMPERATURE
+    var dispTemp = ReadMonitorNum("txtTemperature");
+    if (!isNaN(dispTemp)) {
+        if (dispTemp >= 39.0) {
+            list.push({ cat: "temperature", prio: "high", box: "fieldsetTemp", msg: "*** TEMP HIGH " + dispTemp.toFixed(1) + " ***" });
+        } else if (dispTemp <= 34.0) {
+            list.push({ cat: "temperature", prio: "high", box: "fieldsetTemp", msg: "*** TEMP LOW " + dispTemp.toFixed(1) + " ***" });
+        } else if (dispTemp >= 38.0) {
+            list.push({ cat: "temperature", prio: "medium", box: "fieldsetTemp", msg: "TEMP HIGH " + dispTemp.toFixed(1) });
+        } else if (dispTemp <= 35.4) {
+            list.push({ cat: "temperature", prio: "medium", box: "fieldsetTemp", msg: "TEMP LOW " + dispTemp.toFixed(1) });
+        }
+    }
+
+    // 6. PERFUSION
+    if (noPerfusion && AlarmNoPerfusionSec >= 7) {
+        list.push({ cat: "perfusion", prio: "medium", box: "fieldsetSpo2", msg: "SpO2 NO PULSE" });
+    } else if (UserDoingCprFlag && isArrest) {
+        list.push({ cat: "perfusion", prio: "medium", box: "fieldsetSpo2", msg: "SpO2 LOW PERFUSION" });
+    } else if (!isArrest && CurrentState.spSignal === 1) {
+        list.push({ cat: "perfusion", prio: "medium", box: "fieldsetSpo2", msg: "LOW PERFUSION" });
+    }
+
+    return list;
+}
+
+function ClearAlarmClasses() {
+    var boxes = ["fieldsetEcg", "fieldsetP1", "fieldsetSpo2", "fieldsetAgm", "fieldsetAwp", "fieldsetSpiro", "fieldsetTemp"];
+    for (var i = 0; i < boxes.length; i++) {
+        var el = $(boxes[i]);
+        if (el) { el.classList.remove("alarm-high", "alarm-medium", "alarm-low"); }
+    }
+}
+
+function UpdateAlarmHeaderUi() {
+    var bar = $("divDragerAlarmBar");
+    var btn = $("btnAudioPause");
+    if (!bar || !btn) return;
+
+    if (AlarmPausedUntilSec > CaseTimeInSec) {
+        var rem = AlarmPausedUntilSec - CaseTimeInSec;
+        var mm = Math.floor(rem / 60);
+        var ss = rem % 60;
+        btn.innerHTML = "Paused " + mm + ":" + (ss < 10 ? "0" : "") + ss;
+        btn.classList.add("paused");
+    } else {
+        btn.innerHTML = "Audio Pause";
+        btn.classList.remove("paused");
+    }
+
+    bar.classList.remove("alarm-high", "alarm-medium", "alarm-low", "alarm-idle");
+    if (!UserCaseRunning || ActiveAlarms.length === 0) {
+        bar.classList.add("alarm-idle");
+        bar.innerHTML = UserCaseRunning ? "MONITORING" : "STANDBY";
+        return;
+    }
+
+    var top = ActiveAlarms[0];
+    var extra = ActiveAlarms.length > 1 ? (" (+" + (ActiveAlarms.length - 1) + ")") : "";
+    bar.classList.add("alarm-" + top.prio);
+    bar.innerHTML = top.msg + extra;
+}
+
+function UpdateAlarms(uiOnly) {
+    var mon = $("divMonitor");
+    if (mon && mon.classList.contains("sim-paused")) return;
+
+    ActiveAlarms = EvaluateAlarms(uiOnly);
+    var rank = { high: 3, medium: 2, low: 1 };
+    ActiveAlarms.sort(function (a, b) { return rank[b.prio] - rank[a.prio]; });
+
+    ClearAlarmClasses();
+    var boxTop = {};
+    for (var i = 0; i < ActiveAlarms.length; i++) {
+        var a = ActiveAlarms[i];
+        if (!boxTop[a.box] || rank[a.prio] > rank[boxTop[a.box]]) {
+            boxTop[a.box] = a.prio;
+        }
+    }
+    for (var boxId in boxTop) {
+        if (Object.prototype.hasOwnProperty.call(boxTop, boxId)) {
+            var el = $(boxId);
+            if (el) { el.classList.add("alarm-" + boxTop[boxId]); }
+        }
+    }
+
+    UpdateAlarmHeaderUi();
+
+    if (ActiveAlarms.length === 0) {
+        AlarmLastPrio = "";
+        return;
+    }
+
+    if (CaseTimeInSec >= AlarmPausedUntilSec) {
+        var top = ActiveAlarms[0];
+        var nowMs = Date.now();
+        var intervalMs = (top.prio === "high") ? 5600 : 12000;
+        var escalated = rank[top.prio] > (rank[AlarmLastPrio] || 0);
+
+        // Play immediately if priority escalated (e.g. medium -> high) or cooldown elapsed
+        if (escalated || (!uiOnly && (nowMs - AlarmLastPlayTime >= intervalMs))) {
+            AlarmLastPlayTime = nowMs;
+            AlarmLastPrio = top.prio;
+            PlayIecAlarmBurst(top.cat, top.prio);
+        }
+    }
