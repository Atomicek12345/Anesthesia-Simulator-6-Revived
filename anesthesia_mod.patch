+    } else if (CurrentCase.leanBodyMass < 101) {
+        UserBagRr = 12; UserBagTv = 200; UserVentRr = 10; UserVentTv = 20 * Math.floor((6 * CurrentCase.leanBodyMass) / 20);
+    } else {
+        UserBagRr = 10; UserBagTv = 400; UserVentRr = 8; UserVentTv = 600;
+    }
+}
+
+function PredictDrugDeltas() {
+    StepPhysiologyDrugs(1.0);
+    SetNextHemoWave();
+}
+
+function PredictRespParams() {
+    StepPhysiologyResp(1.0);
+    SetNextRespWave();
+}
+
+function CompareOp(val1, val2, op) {
+    if (op == "GT") return val1 > val2;
+    if (op == "LT") return val1 < val2;
+    if (op == "EQ") return val1 == val2;
+    throw "invalid operator: " + op;
+}
+
+function EvaluateCondition(condition) {
+    switch (condition.type) {
+        case "time":
+            return CompareOp(CaseTimeInSec - StateStartTime, condition.value, condition.op);
+        case "timeSinceCaseStart":
+            return CompareOp(CaseTimeInSec, condition.value, condition.op);
+        case "timeSinceEvent":
+            var evTime = ModernEventState.times[condition.event];
+            if (evTime === undefined) return false;
+            return CompareOp(CaseTimeInSec - evTime, condition.value, condition.op);
+        case "eventFired":
+            return Boolean(ModernEventState.fired[condition.event]) === condition.value;
+        case "tryLaryTube": return UserTriedLaryTubeFlag == condition.value;
+        case "tryFo": return UserTriedFoFlag == condition.value;
+        case "tryLma": return UserTriedLmaFlag == condition.value;
+        case "checkTube": return UserCheckedTubeFlag == condition.value;
+        case "adjustHead": return UserAdjustedHeadFlag == condition.value;
+        case "nasalAirway": return UserInsertedNasalFlag == condition.value;
+        case "oralAirway": return UserInsertedOralFlag == condition.value;
+        case "doingCricoid": return UserDoingCricoidFlag == condition.value;
+        case "suction": return UserSuctionedFlag == condition.value;
+        case "airwayLma": return (UserAirwayStr == "lma") == condition.value;
+        case "airwayTube": return (UserAirwayStr == "tube") == condition.value;
+        case "airwayCrico": return (UserAirwayStr == "crico") == condition.value;
+        case "tubeAbove": return (PrpTubeStatusStr == "tubeAboveCords") == condition.value;
+        case "tubeEsoph": return (PrpTubeStatusStr == "tubeInEsophagus") == condition.value;
+        case "tubeMainstem": return (PrpTubeStatusStr == "tubeInRightMainstem") == condition.value;
+        case "tubeTrachea": return (PrpTubeStatusStr == "tubeInTrachea") == condition.value;
+        case "doa": return CompareOp(PddDoa, condition.value, condition.op);
+        case "mac": return CompareOp(PrpMac, condition.value, condition.op);
+        case "mic": return CompareOp(PddMic, condition.value, condition.op);
+        case "nmb": return CompareOp(PddNmb, condition.value, condition.op);
+        case "nitrousOxide": return CompareOp(PrpAlvN2O, condition.value, condition.op);
+        case "halothane": return CompareOp(PrpAlvHal, condition.value, condition.op);
+        case "tFluid": return CompareOp(PddTfluid, condition.value, condition.op);
+        case "aspirateCvp": return UserAspiratedCvpFlag == condition.value;
+        case "level": return (UserPositionStr == "supine") == condition.value;
+        case "revTrend": return (UserPositionStr == "reverseTrend") == condition.value;
+        case "trend": return (UserPositionStr == "trend") == condition.value;
+        case "makeIncision": return UserMakeIncisionFlag == condition.value;
+        case "doingSurgery": return (UserSurgeonModeStr == "operating") == condition.value;
+        case "chestTube": return UserInsertedChestTubeFlag == condition.value;
+        case "defib": return (UserDefibedEnergy > 0) && !UserSyncedFlag && CompareOp(UserDefibedEnergy, condition.value, condition.op);
+        case "sync": return (UserDefibedEnergy > 0) && UserSyncedFlag && CompareOp(UserDefibedEnergy, condition.value, condition.op);
+        case "doingCpr": return UserDoingCprFlag == condition.value;
+        case "floodField": return UserFloodedFieldFlag == condition.value;
+        case "icedIv": return UserDoingIcedIvFlag == condition.value;
+        case "icedLavage": return UserDoingIcedLavageFlag == condition.value;
+        case "icePack": return UserDoingIcePackFlag == condition.value;
+        case "warmBlanket": return UserDoingWarmBlanketFlag == condition.value;
+        case "warmIv": return UserDoingWarmIvFlag == condition.value;
+        case "checkCircuit": return UserCheckedCircuitFlag == condition.value;
+        case "o2Sat": return CompareOp(PrpSpO2, condition.value, condition.op);
+        case "pCO2": return CompareOp(PrpArtPco2, condition.value, condition.op);
+        case "etco2": return CompareOp(PrpEtCO2, condition.value, condition.op);
+        case "peep": return CompareOp(UserPeep, condition.value, condition.op);
+        case "hr": return CompareOp(PddHr, condition.value, condition.op);
+        case "sbp": return CompareOp(PddAbpS, condition.value, condition.op);
+        case "map": return CompareOp(PddAbpM, condition.value, condition.op);
+        case "temp": return CompareOp(PrpTemperature, condition.value, condition.op);
+        case "ebl": return CompareOp(PddTebl, condition.value, condition.op);
+        case "pot": return CompareOp(PrpPotassium, condition.value, condition.op);
+        case "hct": return CompareOp(PrpHct, condition.value, condition.op);
+        case "drugCe":
+            var idxCe = ConvertDrugKeyToIndex(condition.drug);
+            return CompareOp(DrugInfo.Drugs[idxCe].pkCe || 0, condition.value, condition.op);
+        case "bDrug":
+            var idxB = ConvertDrugKeyToIndex(condition.drug);
+            return DrugInfo.Drugs[idxB].adminBolusFlag == true && CompareOp(DrugInfo.Drugs[idxB].adminBolusAmount, condition.value, condition.op);
+        case "iDrug":
+            var idxI = ConvertDrugKeyToIndex(condition.drug);
+            return DrugInfo.Drugs[idxI].adminInfusionFlag == true && CompareOp(DrugInfo.Drugs[idxI].adminInfusionRate, condition.value, condition.op);
+        default:
+            throw "invalid condition type: " + condition.type;
+    }
+}
+
+function ConsumeBolusConditions(conditions) {
+    for (var i = 0; i < conditions.length; i++) {
+        if (conditions[i].type == "bDrug") {
+            var idx = ConvertDrugKeyToIndex(conditions[i].drug);
+            DrugInfo.Drugs[idx].adminBolusAmount = 0.0;
+            DrugInfo.Drugs[idx].adminBolusFlag = false;
+        }
+    }
+}
+
+function UpdateModernExam() {
+    if (!CurrentCase || CurrentCase.format !== "modern") return;
+    if (!CurrentState._customMental) {
+        if (PddDoa >= 0.9) {
+            CurrentState.mentalStatusMsg = "The patient is unconscious and unresponsive.";
+            CurrentState.lidReflexMsg = "The lid reflex is absent.";
+            CurrentState.pupilsMsg = "The pupils are small and non-reactive.";
+        } else if (PddDoa >= 0.3) {
+            CurrentState.mentalStatusMsg = "The patient is sedated with slowed response to voice.";
+            CurrentState.lidReflexMsg = "There is mild ptosis; lid reflex is sluggish.";
+            CurrentState.pupilsMsg = "The pupils are equal and reactive.";
+        } else if (PddNmb > 0.7) {
+            CurrentState.mentalStatusMsg = "The patient is unable to move but appears awake and distressed!";
+            CurrentState.lidReflexMsg = "The lid reflex is abolished by neuromuscular blockade.";
+            CurrentState.pupilsMsg = "The pupils are dilated and reactive.";
+        } else {
+            CurrentState.mentalStatusMsg = "The patient is awake and alert.";
+            CurrentState.lidReflexMsg = "The lid reflex is present.";
+            CurrentState.pupilsMsg = "The pupils are equal, round, and reactive to light.";
+        }
+    }
+}
+
+function ProcessFsm() {
+    if (CurrentCase.format === "modern") {
+        ProcessModernEvents();
+    } else {
+        ProcessLegacyFsm();
+    }
+}
+
+function ProcessLegacyFsm() {
+    for (var iTrans = 0; iTrans < CurrentState.trans.length; iTrans++) {
+        var tran = CurrentState.trans[iTrans];
+        var allMet = true;
+        for (var iCond = 0; iCond < tran.conditions.length; iCond++) {
+            if (!EvaluateCondition(tran.conditions[iCond])) {
+                allMet = false;
+                break;
+            }
+        }
+        if (allMet) {
+            CaseLogStr2 = CaseLogStr2.concat(tran.comment + "\n");
+            Score += tran.points;
+            ConsumeBolusConditions(tran.conditions);
+            CurrentStateIndex = ConvertStateNameToIndex(tran.nextState);
+            SetCurrentState();
+            break;
+        }
+    }
+}
+
+function ProcessModernEvents() {
+    UpdateModernExam();
+    var events = CurrentCase.events || [];
+    for (var i = 0; i < events.length; i++) {
+        var ev = events[i];
+        if (ev.once !== false && ModernEventState.fired[ev.id]) continue;
+        if (ev.cooldown && ModernEventState.times[ev.id] !== undefined && (CaseTimeInSec - ModernEventState.times[ev.id]) < ev.cooldown) continue;
+
+        var allMet = true;
+        var conds = ev.when || [];
+        for (var c = 0; c < conds.length; c++) {
+            if (!EvaluateCondition(conds[c])) {
+                allMet = false;
+                break;
+            }
+        }
+        if (!allMet) continue;
+
+        ModernEventState.fired[ev.id] = true;
+        ModernEventState.times[ev.id] = CaseTimeInSec;
+        ConsumeBolusConditions(conds);
+
+        if (ev.points) { Score += ev.points; }
+        if (ev.log) { CaseLogStr2 = CaseLogStr2.concat(ev.log + (ev.points ? " (" + (ev.points > 0 ? "+" : "") + ev.points + " points)" : "") + "\n"); }
+
+        if (ev.effects) {
+            for (var key in ev.effects) {
+                if (Object.prototype.hasOwnProperty.call(ev.effects, key)) {
+                    CurrentState[key] = ev.effects[key];
+                    if (key === "mentalStatusMsg") CurrentState._customMental = true;
+                }
+            }
+        }
+        if (ev.whatNext) { CurrentState.whatNextMsg = ev.whatNext; }
+        if (ev.recordMsg) {
+            CurrentState.recordMsg = ev.recordMsg;
+            RecordHeader();
+        }
+        if (ev.finalState !== undefined) {
+            CurrentState.finalState = ev.finalState;
+            if (ev.finalState === 1 && Score >= CurrentCase.possiblePoints * 0.7) { GradeStr = "Pass"; }
+        }
+        if (UserShowingWhatNowFlag) { ShowWhatNow(); }
+    }
+}
+
+function SetCurrentCase() {
+    var tmpIndex = $("caseList").value;
+    if (tmpIndex >= 1) {
+        CurrentCaseIndex = tmpIndex;
+        CurrentCase = CaseData[CurrentCaseIndex];
+
+        if (CurrentCase.format === "modern") {
+            var p = CurrentCase.patient || {};
+            for (var prop in CaseDefault) {
+                if (CurrentCase[prop] == undefined) {
+                    CurrentCase[prop] = (p[prop] !== undefined) ? p[prop] : CaseDefault[prop];
+                }
+            }
+        } else {
+            for (var property in CaseDefault) {
+                if (CurrentCase[property] == undefined) { CurrentCase[property] = CaseDefault[property]; }
+            }
+        }
+
+        InitializeCaseParams();
+        CaseTimeInSec = 0;
+        var currentTime = new Date().getTime();
+        LastOneSecUpdate = currentTime;
+        LastHemoUpdate = currentTime;
+        LastRespUpdate = currentTime;
+        LastTenSecUpdate = currentTime;
+        CurrentStateIndex = 0;
+        UserConnectedThisCaseFlag = false;
+        ResetWaveformSynth();
+        SetCurrentState();
+        NbpM = 0;
+    }
+
+    $("txtCaseTitle").innerHTML = CurrentCase.title;
+    $("selectcase").hide();
+    $("imgPatient").src = "images/clr_" + CurrentCase.imageSet + ".jpg";
+    UserCaseRunning = true;
+    ShowPreopScreen();
+    if (MyTimeout) { clearTimeout(MyTimeout); }
+    EnableSideMenu();
+    $("btnGo").disabled = false;
+    $("selNbpInterval").disabled = false;
+    $("btnGo").className = "clsButtonEnabled";
+    $("seldivN2O").disabled = false;
+    $("seldivAir").disabled = false;
+    $("seldivO2").disabled = false;
+    $("selVaporizer").disabled = false;
+    $("selVapAmount").disabled = false;
+    UserNbpModeStr = "deflating";
+    NbpM = -16;
+    UserNbpInterval = parseFloat($("selNbpInterval").value);
+    NbpTimer = Math.round(UserNbpInterval * 60);
+    UpdateNumberDisplay();
+    if (typeof EnsureAudioCtx === "function") { EnsureAudioCtx(); }
+    StartWaveformLoop();
+    MyTimeout = setTimeout(Update, TimeoutInterval);
+}
+
+function SetCurrentState() {
+    if (CurrentCase.format === "modern") {
+        CurrentState = Object.assign({}, StateDefault, CurrentCase.patient || {}, {
+            finalState: 0,
+            whatNextMsg: CurrentCase.initialWhatNext || "Establish IV access and monitor the patient.",
+            recordMsg: CurrentCase.initialRecordMsg || "Patient in OR awaiting induction.",
+            _customMental: false
+        });
+    } else {
+        CurrentState = CurrentCase.states[CurrentStateIndex];
+        for (var property in StateDefault) {
+            if (CurrentState[property] == undefined) { CurrentState[property] = StateDefault[property]; }
+        }
+    }
+
+    StateStartTime = CaseTimeInSec;
+
+    if (PddHr == -99) {
+        PddHr = CurrentState.baseHr;
+        PddBaseHr = CurrentState.baseHr;
+        PddBaseSpRate = CurrentState.spRate;
+        PddAbpS = CurrentState.baseAbpS;
+        PddAbpD = CurrentState.baseAbpD;
+        PddAbpM = CurrentState.baseAbpM;
+        PddBaseAbpS = CurrentState.baseAbpS;
+        PddBaseAbpD = CurrentState.baseAbpD;
+        PddBaseAbpM = CurrentState.baseAbpM;
+        PddBaseCvp = CurrentState.cvp;
+        PddBasePapS = CurrentState.papS;
+        PddBasePapD = CurrentState.papD;
+        PddBasePapM = CurrentState.papM;
+        PddBasePapW = CurrentState.papW;
+        PddBaseCo = CurrentState.cardiacOutput;
+        PrpMonRr = CurrentState.spontRr;
+        PrpGlucose = CurrentState.glucose;
+        PrpTemperature = CurrentState.temperature;
+        PrpHct = CurrentState.hct;
+        PrpMv = CurrentState.spontRr * CurrentState.spontTv;
+        PrpSpO2 = CurrentCase.initialSat;
+    }
+
+    PredictDrugDeltas();
+    PredictRespParams();
+    if (CurrentStateIndex == 0) {
+        HemoCurrentPoint = 0;
+        RespCurrentPoint = 1;
+    }
+
+    UserAdjustedHeadFlag = false; UserCheckedTubeFlag = false; UserDefibedEnergy = 0;
+    UserInsertedNasalFlag = false; UserInsertedOralFlag = false; UserMakeIncisionFlag = false;
+    UserSuctionedFlag = false; UserTriedFoFlag = false; UserTriedLaryTubeFlag = false; UserTriedLmaFlag = false;
+    RecordHeader();
+    if (UserShowingWhatNowFlag) { ShowWhatNow(); }
+}
+
+function Update() {
+    var currentTime = new Date().getTime();
+    if (currentTime - LastOneSecUpdate >= 200) {
+        LastOneSecUpdate = currentTime;
+        if (UpdateOneSecCount == 0) { PredictDrugDeltas(); }
+        else if (UpdateOneSecCount == 1) { PredictRespParams(); }
+        else if (UpdateOneSecCount == 2) { UpdateSurgeon(); }
+        else if (UpdateOneSecCount == 3) { if (CurrentState.finalState == 0) { ProcessFsm(); } }
+        else if (UpdateOneSecCount == 4) {
+            CaseTimeInSec += 1;
+            RecordSample(false);
+            UpdateNumberDisplay();
+            if (typeof UpdateAlarms === "function") { UpdateAlarms(); }
+            UpdateOneSecCount = -1;
+        }
+        UpdateOneSecCount += 1;
+    }
+    if (currentTime - LastTenSecUpdate >= 10000) { LastTenSecUpdate = currentTime; }
+    if (UserOverdosedFlag == false) { MyTimeout = setTimeout(Update, TimeoutInterval); }
+}
+
+function UpdateSurgeon() {
+    if ((UserSurgeonModeStr == "prepping") && (CaseTimeInSec - SurgeonStartTime >= CurrentCase.durationPrep) && UserMgmtEnabledFlag) {
+        UserSurgeonModeStr = "readyToMakeIncision";
+        ShowSurgeonScreen();
+    }
+    if ((UserSurgeonModeStr == "makingIncision") && (CaseTimeInSec - SurgeonStartTime >= 10) && UserMgmtEnabledFlag) {
+        UserSurgeonModeStr = "operating";
+        SurgeonStartTime = CaseTimeInSec;
+        if (CurrentCase.format === "modern") { ModernEventState.times["incision"] = CaseTimeInSec; }
+        ShowSurgeonScreen();
+    }
+    if ((UserSurgeonModeStr == "operating") && (CaseTimeInSec - SurgeonStartTime >= CurrentCase.durationSurgery) && UserMgmtEnabledFlag) {
+        UserSurgeonModeStr = "closing";
+        SurgeonStartTime = CaseTimeInSec;
+        ShowSurgeonScreen();
+    }
+    if ((UserSurgeonModeStr == "closing") && (CaseTimeInSec - SurgeonStartTime >= 180) && UserMgmtEnabledFlag) {
+        UserSurgeonModeStr = "done";
+        ShowSurgeonScreen();
+    }
+}
