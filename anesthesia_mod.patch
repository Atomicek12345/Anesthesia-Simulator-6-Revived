+                const tHalfElim = Math.LN2 / effK10;
+                modalTimingSummary.textContent = `Sim Effect-Site t½: ${formatSimTime(tHalfEq)} | Sim Elim t½: ${formatSimTime(tHalfElim)}`;
+
+                const cells = [
+                    { label: 'ke0 (Brain)', val: `${p.ke0}/s` },
+                    { label: 'k10 (Elim)', val: `${p.k10}/s` },
+                    { label: 'Hill γ / EC50', val: `${p.gamma} / ${p.ec50 || 1.0}` },
+                    { label: 'Emax / Gain', val: `${p.emaxScale}× / ${p.bolusGain}×` }
+                ];
+                cells.forEach(c => {
+                    const div = document.createElement('div');
+                    div.className = 'bg-slate-950/60 p-2 rounded-lg border border-emerald-900/30';
+                    div.innerHTML = `<div class="text-[10px] text-slate-400">${c.label}</div><div class="text-emerald-300 font-semibold">${c.val}</div>`;
+                    modalPkGrid.appendChild(div);
+                });
+            } else if (drug.isGas) {
+                modalTimingSummary.textContent = `GasTimeScale: ${GAS_TIME_SCALE}×`;
+                const cells = [
+                    { label: 'Engine MAC', val: `${drug.bolusE100}%` },
+                    { label: 'Model', val: '3-Comp Circle' },
+                    { label: 'BP Penalty', val: '-10.5 / MAC' },
+                    { label: 'Apnea Threshold', val: '> 0.85 DOA' }
+                ];
+                cells.forEach(c => {
+                    const div = document.createElement('div');
+                    div.className = 'bg-slate-950/60 p-2 rounded-lg border border-emerald-900/30';
+                    div.innerHTML = `<div class="text-[10px] text-slate-400">${c.label}</div><div class="text-emerald-300 font-semibold">${c.val}</div>`;
+                    modalPkGrid.appendChild(div);
+                });
+            } else {
+                const cells = [
+                    { label: 'Primary Effect', val: drug.effect || 'none' },
+                    { label: 'Magnitude', val: `${drug.effectMagnitude || 0}` },
+                    { label: 'Fallback Dur', val: `${drug.effectSec || 900}s` },
+                    { label: 'OD Threshold', val: formatOverdoseThreshold(drug, weight) }
+                ];
+                cells.forEach(c => {
+                    const div = document.createElement('div');
+                    div.className = 'bg-slate-950/60 p-2 rounded-lg border border-slate-800';
+                    div.innerHTML = `<div class="text-[10px] text-slate-400">${c.label}</div><div class="text-slate-300 font-semibold">${c.val}</div>`;
+                    modalPkGrid.appendChild(div);
+                });
+            }
+
+            modalUse.textContent = drug.useStr || 'None specified';
+
+            let doseHtml = calculateDosages(drug.doseStr, weight) || 'None specified';
+            const potencyLine = formatE100Potency(drug, weight);
+            const odLine = formatOverdoseThreshold(drug, weight);
+            if (potencyLine || odLine !== "—") {
