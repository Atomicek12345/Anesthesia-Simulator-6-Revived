+        function getEnginePhysiology(drug) {
+            const name = drug.nameStr;
+            const prof = EnginePkProfiles[name];
+            const sec = EngineSecondaryEffects[name];
+            const spec = SpecialEngineBehaviors[name];
+
+            if (spec) {
+                return {
+                    active: spec.active,
+                    cls: prof ? prof.cls : (drug.isGas ? "volatile_gas" : (drug.effect || "none")),
+                    prof: prof || null,
+                    sec: sec || null,
+                    tags: spec.tags,
+                    summary: spec.summary
+                };
+            }
+
+            // Default fallback for non-modeled adjuncts
+            return {
+                active: false,
+                cls: "non_modeled",
+                prof: null,
+                sec: null,
+                tags: [{ label: "Non-Modeled Adjunct", tone: "slate" }],
+                summary: "• Reference-only entry: This medication is included in DrugInfo for clinical reference and dosing, but has no active pharmacodynamic hook in PhysiologyEngine.js (effect = 'none')."
+            };
+        }
+
+        function formatSimTime(sec) {
+            if (!isFinite(sec) || sec <= 0) return "—";
+            if (sec < 60) return `${Math.round(sec)}s`;
+            const mins = sec / 60;
+            if (mins < 60) return `${mins.toFixed(1)} min`;
+            return `${(mins / 60).toFixed(1)} hr`;
+        }
