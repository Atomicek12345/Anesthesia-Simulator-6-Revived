+            RespContext.fillRect(RespX1, APY2, 2, (pawBaseY - APY2) + 0.5);
+        }
+        RespContext.strokeStyle = "#7CE8FF";
+        RespContext.beginPath();
+        RespContext.moveTo(RespX1, APY1);
+        RespContext.lineTo(RespX2, APY2);
+        RespContext.stroke();
+    }
