+}
+
+function ResetRecorder() {
+    AimsSamples = [];
+    AimsEvents = [];
+    LastAimsSampleSec = -999;
+}
+
+function RecordSample(force) {
+    if (!UserCaseRunning || !CurrentState) return;
+    if (!force && (CaseTimeInSec - LastAimsSampleSec) < 5) return;
+    LastAimsSampleSec = CaseTimeInSec;
+    AimsSamples.push({
+        t: CaseTimeInSec,
+        hr: Math.round(PddHr || 0),
+        spo2: Math.round(PrpSpO2 || 0),
+        etco2: Math.round(PrpEtCO2 || 0),
+        mac: +(PrpMac || 0).toFixed(2)
+    });
+
+    // Only auto-record BP here if continuous arterial line is inserted (every 15s)
+    if (UserInsertedArtLineFlag && (CaseTimeInSec - LastArtBpSec) >= 15) {
+        LastArtBpSec = CaseTimeInSec;
+        AimsBpPoints.push({ t: CaseTimeInSec, sbp: Math.round(PddAbpS || 0), dbp: Math.round(PddAbpD || 0) });
+    }
+
+    var c = $("canvasTrendChart");
+    if (c) RenderTrendChart(c);
+}
+
+function RecordHeader() {
