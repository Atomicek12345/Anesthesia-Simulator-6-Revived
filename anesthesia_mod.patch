+    var line = MakeTimeStr() + "    " + (CurrentState.recordMsg || "") + "\n";
+    line += "ECG: " + rhythmDesc + ",  HR " + PddHr.toFixed(0) + ",  BP " + PddAbpS.toFixed(0) + "/" + PddAbpD.toFixed(0);
+    if (UserConnectedFlag) {
+        line += ",  FiO2 " + PrpFiO2.toFixed(0) + ",  RR " + PrpMonRr.toFixed(0) + ",  TV " + PrpMonTv.toFixed(0);
+    }
+    line += ",  SpO2 " + PrpSpO2.toFixed(0);
+    if (UserConnectedFlag) {
+        line += ",  ET-CO2 " + PrpEtCO2.toFixed(0) + ",  ET-" + UserVapStr + " " + PrpFeAgt.toFixed(1);
+    }
+    CaseLogStr2 = CaseLogStr2.concat(line + "\n");
+    RecordSample(true);
+}
+
+function RecordMeds(bAmount, iAmount) {
+    var d = DrugInfo.Drugs[UserDrugIndex];
+    if (!d) return;
+    var msg = "";
+    if (parseFloat(bAmount) > 0) {
+        msg += d.nameStr + " " + bAmount + " " + d.bolusUnit + ". ";
