+    target.addEventListener("wheel", function (e) {
+        if (el.disabled) return;
+        e.preventDefault();
+        e.stopPropagation();
+        var dir = (e.deltaY < 0) ? 1 : -1;
+        var nextIdx = el.selectedIndex + dir;
+        if (nextIdx >= 0 && nextIdx < el.options.length) {
+            el.selectedIndex = nextIdx;
+            el.dispatchEvent(new Event("change", { bubbles: true }));
+        }
+        if (window.scrollY !== 0 || window.scrollX !== 0) {
+            window.scrollTo(0, 0);
+        }
+    }, { passive: false });
+}
+
+function InitCustomSelects() {
+    var activeSelect = null;
+    var popup = null;
+
+    function closePopup() {
+        if (popup && popup.parentNode) {
+            popup.parentNode.removeChild(popup);
+        }
+        popup = null;
+        activeSelect = null;
+    }
+
+    function openPopup(sel) {
+        closePopup();
+        activeSelect = sel;
+
+        popup = document.createElement("div");
+        popup.id = "customSelectPopup";
+
+        for (var i = 0; i < sel.options.length; i++) {
+            (function (idx) {
+                var opt = document.createElement("div");
+                opt.className = "csp-opt" + (idx === sel.selectedIndex ? " selected" : "");
+                opt.textContent = sel.options[idx].text;
+                opt.addEventListener("mouseenter", function () {
+                    var prev = popup.querySelector(".csp-opt.selected");
+                    if (prev) prev.classList.remove("selected");
+                    opt.classList.add("selected");
+                });
+                opt.addEventListener("mousedown", function (e) {
+                    e.preventDefault();
+                    e.stopPropagation();
+                    sel.selectedIndex = idx;
+                    closePopup();
+                    sel.dispatchEvent(new Event("change", { bubbles: true }));
+                });
+                popup.appendChild(opt);
+            })(i);
+        }
+
+        document.body.appendChild(popup);
+
+        var rect = sel.getBoundingClientRect();
+        var s = CurrentUiScale || 1;
+        var baseW = rect.width / s;
+        var popW = baseW;
+        if (sel.id === "caseList" || sel.id === "selDrugList") {
+            popW = Math.max(baseW, popup.scrollWidth + 8);
+        }
+        popW = Math.min(popW, (window.innerWidth - 16) / s);
+        popup.style.width = popW + "px";
+
+        var spaceBelow = (window.innerHeight - rect.bottom - 8) / s;
+        var spaceAbove = (rect.top - 8) / s;
+        var maxH = 380;
+
+        if (spaceBelow < 200 && spaceAbove > spaceBelow) {
+            popup.style.transformOrigin = "bottom left";
+            popup.style.maxHeight = Math.min(maxH, spaceAbove) + "px";
+            popup.style.bottom = (window.innerHeight - rect.top + 1) + "px";
+            popup.style.top = "auto";
+        } else {
+            popup.style.transformOrigin = "top left";
+            popup.style.maxHeight = Math.min(maxH, Math.max(120, spaceBelow)) + "px";
+            popup.style.top = (rect.bottom + 1) + "px";
+            popup.style.bottom = "auto";
+        }
+
+        popup.style.transform = "scale(" + s.toFixed(4) + ")";
+        var left = Math.min(rect.left, window.innerWidth - popW * s - 8);
+        popup.style.left = Math.max(8, left) + "px";
+
+        var selEl = popup.querySelector(".csp-opt.selected");
+        if (selEl) {
+            popup.scrollTop = Math.max(0, selEl.offsetTop - popup.clientHeight / 2 + selEl.offsetHeight / 2);
+        }
+    }
+
+    document.addEventListener("mousedown", function (e) {
+        if (popup && (e.target === popup || popup.contains(e.target))) return;
+
+        var sel = e.target && e.target.tagName === "SELECT" ? e.target : null;
+        if (sel && e.button === 0 && !sel.disabled && sel.size <= 1) {
+            e.preventDefault();
+            if (activeSelect === sel) {
+                closePopup();
+            } else {
+                openPopup(sel);
+            }
+            return;
+        }
+        closePopup();
+    }, true);
+
+    document.addEventListener("keydown", function (e) {
+        if (e.key === "Escape" && popup) closePopup();
+    });
+
+    window.addEventListener("blur", closePopup);
+}
