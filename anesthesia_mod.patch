+function FilterDrugList(text) {
+    var sel = $("selDrugList");
+    var keep = sel.value;
+    var q = text.toLowerCase().replace(/\s/g, "");
+    var starts = [];
+    var contains = [];
+    for (var i = 1; i < DrugInfo.Drugs.length; i++) {
+        var nm = DrugInfo.Drugs[i].nameStr;
+        var low = nm.toLowerCase().replace(/\s/g, "");
+        if (q == "") { starts.push({ i: i, nm: nm }) }
+        else if (low.indexOf(q) == 0) { starts.push({ i: i, nm: nm }) }
+        else if (low.indexOf(q) > 0) { contains.push({ i: i, nm: nm }) }
+    }
+    if (q != "") {
+        var byName = function (a, b) { return a.nm.toLowerCase() < b.nm.toLowerCase() ? -1 : 1 };
+        starts.sort(byName);
+        contains.sort(byName);
+    }
+    var all = starts.concat(contains);
+    sel.length = 0;
+    var o = document.createElement("option");
+    o.setAttribute("value", 0);
+    o.innerHTML = DrugInfo.Drugs[0].nameStr;
+    sel.appendChild(o);
+    for (var k = 0; k < all.length; k++) {
+        o = document.createElement("option");
+        o.setAttribute("value", all[k].i);
+        o.innerHTML = all[k].nm;
+        sel.appendChild(o);
+    }
+    sel.value = keep;
+    if (q == "") { sel.size = 1 } else { sel.size = Math.min(all.length + 1, 8) }
+}
