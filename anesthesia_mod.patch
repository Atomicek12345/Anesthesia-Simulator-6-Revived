+        // Dynamic dosage & engine threshold calculator based on patient Lean Body Mass (LBM)
+        function calculateDosages(doseStr, weight) {
+            if (!doseStr) return doseStr;
+            let computedStr = doseStr;
+
+            // 1. Ranges: e.g. "0.5 - 2 mg/kg" or "0.5-3.0 mcg/kg/min"
+            computedStr = computedStr.replace(/(\d+(?:\.\d+)?)\s*(?:-|to)\s*(\d+(?:\.\d+)?)\s*(mg|mcg|ml|mL)\/kg(\/(?:min|hr))?/gi, (match, min, max, unit, rate) => {
+                const low = +(parseFloat(min) * weight).toFixed(2);
+                const high = +(parseFloat(max) * weight).toFixed(2);
+                const rateSuffix = rate ? rate : '';
+                return `${match} <span class="text-blue-400 font-semibold">[${low}–${high} ${unit}${rateSuffix}]</span>`;
+            });
+
+            // 2. Single values: e.g. "0.1 mg/kg" or "50 mcg/kg" (skipping anything already converted)
+            computedStr = computedStr.replace(/(\d+(?:\.\d+)?)\s*(mg|mcg|ml|mL)\/kg(\/(?:min|hr))?(?!\s*<span)/gi, (match, val, unit, rate) => {
+                const total = +(parseFloat(val) * weight).toFixed(2);
+                const rateSuffix = rate ? rate : '';
+                return `${match} <span class="text-blue-400 font-semibold">[${total} ${unit}${rateSuffix}]</span>`;
+            });
+
+            return computedStr;
+        }
+
+        function formatOverdoseThreshold(drug, weight) {
+            if (!drug.overdose) return "—";
+            if (drug.isGas) return `${drug.overdose}%`;
+            const unit = (drug.bolusUnit && drug.bolusUnit !== "none") ? drug.bolusUnit : "units";
+            const totalOd = +(drug.overdose * weight).toFixed(2);
+            return `${drug.overdose}/kg (${totalOd} ${unit})`;
+        }
+
+        function formatE100Potency(drug, weight) {
+            const parts = [];
+            if (drug.bolusE100 && drug.bolusE100 > 0 && drug.bolusUnit && drug.bolusUnit !== "none") {
+                if (drug.isGas) {
+                    parts.push(`1.0 MAC = ${drug.bolusE100}%`);
+                } else {
+                    const totalE100 = +(drug.bolusE100 * weight).toFixed(2);
+                    parts.push(`1.0 E100 Bolus = ${drug.bolusE100} ${drug.bolusUnit}/kg (${totalE100} ${drug.bolusUnit})`);
+                }
+            }
+            if (drug.infusionE100 && drug.infusionE100 > 0 && drug.infusionUnit && drug.infusionUnit !== "none") {
+                parts.push(`1.0 E100 Infusion = ${drug.infusionE100} ${drug.infusionUnit}`);
+            }
+            return parts.join(" | ");
+        }
+
+        let currentFilter = 'all';
+        let searchQuery = '';
+        let simActiveOnly = false;
+
+        const drugGrid = document.getElementById('drugGrid');
+        const emptyState = document.getElementById('emptyState');
+        const searchInput = document.getElementById('searchInput');
+        const weightInput = document.getElementById('patientWeight');
+        const simActiveToggle = document.getElementById('simActiveToggle');
+        const simActiveDot = document.getElementById('simActiveDot');
+
+        simActiveToggle.addEventListener('click', () => {
+            simActiveOnly = !simActiveOnly;
+            if (simActiveOnly) {
+                simActiveToggle.className = 'px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-300 border border-emerald-500/40 text-xs font-semibold transition flex items-center gap-1.5 shadow';
+                simActiveDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
+            } else {
+                simActiveToggle.className = 'px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 text-xs font-semibold transition flex items-center gap-1.5';
+                simActiveDot.className = 'w-2 h-2 rounded-full bg-slate-500';
+            }
+            renderDrugs();
+        });
+
+        function renderDrugs() {
+            const weight = parseFloat(weightInput.value) || 70;
+            const query = searchQuery.toLowerCase().trim();
+
+            drugGrid.innerHTML = '';
+
+            const filtered = drugs.filter(drug => {
+                const phys = getEnginePhysiology(drug);
+                if (simActiveOnly && !phys.active) return false;
+                const matchesCat = inGroup(drug, currentFilter);
+                const physText = `${phys.cls} ${phys.tags.map(t => t.label).join(' ')} ${phys.summary}`.toLowerCase();
+                const matchesSearch = !query || 
+                    drug.nameStr.toLowerCase().includes(query) || 
+                    drug.useStr.toLowerCase().includes(query) || 
+                    drug.actionStr.toLowerCase().includes(query) ||
+                    drug.complicationStr.toLowerCase().includes(query) ||
+                    physText.includes(query);
+                return matchesCat && matchesSearch;
+            });
+
+            if (filtered.length === 0) {
+                emptyState.classList.remove('hidden');
+                return;
+            } else {
+                emptyState.classList.add('hidden');
+            }
+
+            filtered.forEach(drug => {
+                const cat = getCategory(drug);
+                const phys = getEnginePhysiology(drug);
+                const card = document.createElement('div');
+                card.className = `bg-slate-900 border ${phys.active ? 'border-slate-800 hover:border-emerald-700/60' : 'border-slate-800/70 hover:border-slate-700 opacity-90'} rounded-xl p-5 transition shadow-lg flex flex-col justify-between cursor-pointer group`;
+                
+                const shortUse = drug.useStr.length > 85 ? drug.useStr.substring(0, 85) + '...' : drug.useStr;
+                const formattedDose = calculateDosages(drug.doseStr, weight);
+                const odDisplay = formatOverdoseThreshold(drug, weight);
+
+                const tagsHtml = phys.tags.slice(0, 3).map(t =>
+                    `<span class="text-[10px] font-semibold px-2 py-0.5 rounded border ${getBadgeToneClasses(t.tone)}">${t.label}</span>`
+                ).join('');
+
+                card.innerHTML = `
+                    <div>
+                        <div class="flex items-start justify-between gap-2 mb-2">
+                            <h3 class="font-bold text-lg text-slate-100 group-hover:text-blue-400 transition">${drug.nameStr}</h3>
+                            <span class="text-[10px] uppercase font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 shrink-0">${cat}</span>
+                        </div>
+                        <div class="flex flex-wrap gap-1 mb-2.5">
+                            ${tagsHtml}
+                        </div>
+                        <p class="text-xs text-slate-400 mb-3 line-clamp-2"><strong class="text-slate-300">Use:</strong> ${shortUse}</p>
+                        <div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800/80 mb-3 font-mono text-xs text-slate-300">
+                            <div class="text-[10px] font-sans font-semibold text-blue-400 uppercase tracking-wider mb-0.5">Dosage:</div>
+                            <div class="line-clamp-3">${formattedDose}</div>
+                        </div>
+                    </div>
+                    <div class="flex items-center justify-between pt-2 border-t border-slate-800/60 text-[11px] text-slate-500">
+                        <span>OD Threshold: <strong class="text-slate-400 font-mono">${odDisplay}</strong></span>
+                        <span class="text-blue-400 font-medium group-hover:translate-x-1 transition-transform">Details →</span>
+                    </div>
+                `;
+
+                card.addEventListener('click', () => openModal(drug, weight));
+                drugGrid.appendChild(card);
+            });
+        }
+
+        // Modal handling
+        const modal = document.getElementById('drugModal');
+        const modalContent = document.getElementById('modalContent');
+        const modalTitle = document.getElementById('modalTitle');
+        const modalBadge = document.getElementById('modalBadge');
+        const modalSimStatus = document.getElementById('modalSimStatus');
+        const modalClassBadge = document.getElementById('modalClassBadge');
+        const modalTimingSummary = document.getElementById('modalTimingSummary');
+        const modalPhysTags = document.getElementById('modalPhysTags');
+        const modalPhysSummary = document.getElementById('modalPhysSummary');
+        const modalPkGrid = document.getElementById('modalPkGrid');
+        const modalUse = document.getElementById('modalUse');
+        const modalDose = document.getElementById('modalDose');
+        const modalAction = document.getElementById('modalAction');
+        const modalComplication = document.getElementById('modalComplication');
+        const closeModal = document.getElementById('closeModal');
+        const closeModalBtn = document.getElementById('closeModalBtn');
+
+        function openModal(drug, weight) {
