+CaseData[31] = {
+    "title": "Case 31 - 23 year old preeclamptic for induction of labor followed by Cesarean delivery", 
+    "badDrugs": ["Dantrolene"], 
+    "coMin": 1, 
+    "debriefMsg": "\n Anesthetic challenges of preeclampsia include maintaining maternal hemodynamic stability (avoiding significant decreases in maternal blood pressure with regional analgesia/anesthesia and avoiding dangerous hypertension with induction of general anesthesia).  Maintaining stable maternal hemodynamics and proper maternal positioning optimizes the fetal condition.\n\n", 
+    "depthCarina": 25, 
+    "depthCords": 18, 
+    "depthTubeInitial": 22, 
+    "durationPrep": 60, 
+    "durationSurgery": 1200, 
+    "helpFlag": true, 
+    "imageSet": 3, 
+    "initialSat": 96, 
