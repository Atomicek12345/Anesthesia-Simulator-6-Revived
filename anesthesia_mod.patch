+        APY2 = APY1 + 0.50 * (APY2 - APY1);
+        
+        if (CO2Y2 < CO2Limit1) { CO2Y2 = CO2Limit1 } else if (CO2Y2 > CO2Limit2) { CO2Y2 = CO2Limit2 } if (APY2 < APLimit1) { APY2 = APLimit1 } else if (APY2 > APLimit2) { APY2 = APLimit2 } HemoContext.strokeStyle = "#FFE600";
+        HemoContext.clearRect(RespX1, 279, 3, 82);
