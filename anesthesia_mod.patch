+}
+
+function RenderTrendChart(canvas) {
+    if (!canvas) return;
+    var w = (canvas.parentElement && canvas.parentElement.clientWidth) ? canvas.parentElement.clientWidth : 378;
+    var h = (canvas.parentElement && canvas.parentElement.clientHeight) ? canvas.parentElement.clientHeight : 326;
+    var dpr = Math.max(window.devicePixelRatio || 1, 3);
+    canvas.width = Math.round(w * dpr);
+    canvas.height = Math.round(h * dpr);
+    canvas.style.width = w + "px";
+    canvas.style.height = h + "px";
+
+    var ctx = canvas.getContext("2d");
+    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+
+    ctx.fillStyle = "#000000";
+    ctx.fillRect(0, 0, w, h);
+
+    var padL = 30, padR = 12, padT = 24, padB = 34;
+    var pw = w - padL - padR, ph = h - padT - padB;
+    var lastT = AimsSamples.length ? AimsSamples[AimsSamples.length - 1].t : 0;
+    var maxT = Math.max(120, Math.ceil(lastT / 60) * 60);
+
+    function xAt(t) { return padL + (t / maxT) * pw; }
+    function yAt(v) { return padT + ph - (Math.max(0, Math.min(200, v)) / 200) * ph; }
+
+    ctx.font = "10px system-ui, sans-serif";
+    for (var yv = 0; yv <= 200; yv += 25) {
+        var gy = yAt(yv);
+        ctx.strokeStyle = (yv % 50 === 0) ? "#222222" : "#121212";
+        ctx.lineWidth = 1;
+        ctx.beginPath(); ctx.moveTo(padL, gy); ctx.lineTo(w - padR, gy); ctx.stroke();
+        if (yv % 50 === 0) {
+            ctx.fillStyle = "#7a8594";
+            ctx.fillText(String(yv), 5, gy + 3);
+        }
+    }
+
+    var stepSec = maxT > 900 ? 300 : (maxT > 300 ? 120 : 60);
+    for (var ts = 0; ts <= maxT; ts += stepSec) {
+        var tx = xAt(ts);
+        ctx.strokeStyle = "#1a1a1a";
+        ctx.beginPath(); ctx.moveTo(tx, padT); ctx.lineTo(tx, padT + ph); ctx.stroke();
+        ctx.fillStyle = "#7a8594";
+        ctx.fillText(Math.floor(ts / 60) + "m", tx - 6, padT + ph + 12);
+    }
+
+    var items = [
+        { lbl: "HR", col: "#28E828" },
+        { lbl: "∨/∧ BP", col: "#FF4444" },
+        { lbl: "SpO2", col: "#FFFFFF" },
+        { lbl: "EtCO2", col: "#FFE600" }
+    ];
+    var lx = padL;
+    ctx.font = "bold 10px system-ui, sans-serif";
+    items.forEach(function (it) {
+        ctx.fillStyle = it.col;
+        ctx.fillText(it.lbl, lx, 14);
+        lx += 62;
+    });
+
+    if (AimsSamples.length === 0) return;
+
+    function plotLine(key, color, width) {
+        ctx.strokeStyle = color;
+        ctx.lineWidth = width || 1.4;
+        ctx.beginPath();
+        for (var i = 0; i < AimsSamples.length; i++) {
+            var x = xAt(AimsSamples[i].t);
+            var y = yAt(AimsSamples[i][key]);
+            if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
+        }
+        ctx.stroke();
+    }
+
+    plotLine("spo2", "rgba(255,255,255,0.85)", 1.3);
+    plotLine("etco2", "#FFE600", 1.3);
+    plotLine("hr", "#28E828", 1.5);
+
+    ctx.lineWidth = 1.2;
+    for (var i = 0; i < AimsBpPoints.length; i++) {
+        var bp = AimsBpPoints[i];
+        var bx = xAt(bp.t);
+        var ys = yAt(bp.sbp);
+        var yd = yAt(bp.dbp);
+        ctx.strokeStyle = "rgba(255,68,68,0.45)";
+        ctx.beginPath(); ctx.moveTo(bx, ys); ctx.lineTo(bx, yd); ctx.stroke();
+
+        ctx.strokeStyle = "#FF4444";
+        ctx.beginPath();
+        ctx.moveTo(bx - 3, ys - 3); ctx.lineTo(bx, ys); ctx.lineTo(bx + 3, ys - 3);
+        ctx.stroke();
+        ctx.beginPath();
+        ctx.moveTo(bx - 3, yd + 3); ctx.lineTo(bx, yd); ctx.lineTo(bx + 3, yd + 3);
+        ctx.stroke();
+    }
+
+    ctx.font = "9px system-ui, sans-serif";
+    var lastEvX = -99;
+    for (var e = 0; e < AimsEvents.length; e++) {
+        var ex = xAt(AimsEvents[e].t);
+        ctx.strokeStyle = "#60A5FA";
+        ctx.beginPath(); ctx.moveTo(ex, padT + ph); ctx.lineTo(ex, padT + ph + 4); ctx.stroke();
+        if (ex - lastEvX >= 28) {
+            lastEvX = ex;
+            ctx.fillStyle = "#60A5FA";
+            ctx.fillText(AimsEvents[e].label.slice(0, 5), ex - 8, h - 5);
+        }
+    }
+}
