+"use strict";
+
+var AimsSamples = [];
+var AimsEvents = [];
+var LastAimsSampleSec = -999;
+
+var AimsSamples = [];
+var AimsBpPoints = [];
+var AimsEvents = [];
+var LastAimsSampleSec = -999;
+var LastArtBpSec = -999;
+
+function ResetRecorder() {
+    AimsSamples = [];
+    AimsBpPoints = [];
+    AimsEvents = [];
+    LastAimsSampleSec = -999;
+    LastArtBpSec = -999;
+}
+
+function RecordBpPoint(sbp, dbp) {
+    if (!UserCaseRunning || sbp < 30) return;
+    AimsBpPoints.push({ t: CaseTimeInSec, sbp: Math.round(sbp), dbp: Math.round(dbp) });
+    var c = $("canvasTrendChart");
